apiVersion: apps/v1
kind: Deployment
metadata:
  name: denmark-railway
  labels:
    app: denmark-railway
spec:
  replicas: 2
  selector:
    matchLabels:
      app: denmark-railway
  template:
    metadata:
      labels:
        app: denmark-railway
    spec:
      containers:
        - name: denmark-railway
          image: yourdockerhubuser/denmarkdailways:latest
          ports:
            - containerPort: 5000
          livenessProbe:
            httpGet:
              path: /health
              port: 5000
            initialDelaySeconds: 5
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /health
              port: 5000
            initialDelaySeconds: 5
            periodSeconds: 5
          resources:
            requests:
              cpu: "50m"
              memory: "64Mi"
            limits:
              cpu: "200m"
              memory: "128Mi"
---
apiVersion: v1
kind: Service
metadata:
  name: denmark-railway-svc
  labels:
    app: denmark-railway
spec:
  selector:
    app: denmark-railway
  ports:
    - name: http
      port: 80
      targetPort: 5000
      nodePort: 30080
  type: NodePort
